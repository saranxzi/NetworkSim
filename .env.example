# NetworkSim Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_USER=networksim
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=networksim_db

# Redis
REDIS_URL=redis://redis:6379

# Auth (set to true and configure JWT_SECRET for production)
AUTH_ENABLED=false
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# CORS
FRONTEND_URL=http://localhost:3000
